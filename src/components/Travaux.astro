---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import Placeholder from './Placeholder.astro';
import { getTravaux } from '@/lib/content';
import norvege from '@/assets/travaux/norvege.jpg';
import elek from '@/assets/travaux/elek.jpg';
import davidLisnard from '@/assets/travaux/david-lisnard-2026.jpg';
import decoFlammePost from '@/assets/travaux/deco-flamme-2024.jpg';
import stephaneEdouard from '@/assets/travaux/stephane-edouard-45.jpg';
import tiktokAdrienpy from '@/assets/travaux/tiktok-adrienpy-hero.jpg';
import tiktokLesMeritants from '@/assets/travaux/tiktok-les-meritants-hd.jpg';

// Vignettes avec une vraie image (miniature vidéo, photo de post
// représentative, portrait…) — passer `srcKey` dans le .md du projet pour
// s'y raccrocher. Les autres vignettes retombent sur le placeholder rayé.
const localImages: Record<string, ImageMetadata> = {
  norvege,
  elek,
  'david-lisnard': davidLisnard,
  'deco-flamme': decoFlammePost,
  'stephane-edouard': stephaneEdouard,
  'tiktok-adrienpy': tiktokAdrienpy,
  'tiktok-les-meritants': tiktokLesMeritants,
};

const allCards = await getTravaux();
// Les clients de l'agence EARLY n'ont plus de vignette image : ils sont
// listés à part (nom + abonnés), sans image, triés par abonnés décroissants
// (ordre déjà trié côté contenu).
const cards = allCards.filter((c) => c.groupe !== 'Agence EARLY');
const earlyCards = allCards.filter((c) => c.groupe === 'Agence EARLY');
const earlyHref = 'https://www.instagram.com/early.fr/';
---

<section class="section" id="travaux" aria-labelledby="travaux-title" data-section="#travaux">
  <div class="wrap">
    <SectionHead title={'Travaux\nrécents'} id="travaux-title" />

    <div class="works reveal" data-stagger="60">
      <div class="works__track" data-carousel data-autoplay="4000">
        {
          cards.map((c, i) => {
            const img = c.srcKey ? localImages[c.srcKey] : undefined;
            const metaLabel = ([c.plateforme, c.nature].filter(Boolean).join(' · ') || c.secteur).toUpperCase();
            const statText = c.vues ? `${c.vues} ${c.unite}` : '';
            const line3 = [c.date, statText].filter(Boolean).join(' — ');
            const external = Boolean(c.href);
            const Tag = external ? 'a' : 'button';
            const tagProps = external
              ? { href: c.href, target: '_blank', rel: 'noopener' }
              : ({
                  type: 'button',
                  'data-lightbox': true,
                  'data-title': c.titre,
                  'data-sector': c.secteur,
                  'data-src': c.src,
                  'data-media-type': c.type,
                  'data-format': c.format,
                } as const);
            const label = external
              ? `Voir « ${c.titre} » sur ${c.plateforme || 'le site externe'} (nouvel onglet)`
              : `Ouvrir « ${c.titre} » en plein écran`;
            return (
              <Tag class="work rippling" aria-label={label} {...tagProps}>
                <span class="work__frame">
                  {img ? (
                    <Picture
                      src={img}
                      alt={c.titre}
                      formats={['avif', 'webp']}
                      widths={[320, 480, 640]}
                      sizes="(min-width: 768px) 25vw, 158px"
                      loading="lazy"
                      class="work__img"
                    />
                  ) : (
                    <Placeholder
                      label={`${c.type === 'image' ? 'CARROUSEL' : 'REEL'} ${c.format}\n${(c.plateforme || 'CLIENT ' + String(i + 1).padStart(2, '0')).toUpperCase()}`}
                      ratio="4 / 5"
                    />
                  )}
                  {c.src && c.type === 'video' && !img && (
                    <video muted loop playsinline preload="none" poster={c.poster || undefined} data-work-video>
                      <source src={c.src} type="video/mp4" />
                    </video>
                  )}
                  <span class="work__arrow" aria-hidden="true">
                    ↗
                  </span>
                </span>
                <span class="work__title">{c.titre}</span>
                <span class="work__meta">{metaLabel}</span>
                {line3 && <span class="work__stat">{line3}</span>}
                {c.credit && <span class="work__credit">{c.credit}</span>}
              </Tag>
            );
          })
        }
      </div>

      <div class="works__dots">
        <span class="works__count" aria-hidden="true" data-counter>
          {String(1).padStart(2, '0')} / {String(cards.length).padStart(2, '0')}
        </span>
        <span class="works__nav">
          <button type="button" class="works__navbtn" data-carousel-prev aria-label="Projet précédent">
            <span aria-hidden="true">&larr;</span>
          </button>
          <button type="button" class="works__navbtn" data-carousel-next aria-label="Projet suivant">
            <span aria-hidden="true">&rarr;</span>
          </button>
        </span>
      </div>
    </div>

    {
      earlyCards.length > 0 && (
        <div class="early reveal" data-stagger="40">
          <a href={earlyHref} target="_blank" rel="noopener" class="early__head rippling">
            <span class="early__label">{earlyCards[0].groupe}</span>
            {earlyCards[0].date && <span class="early__date">{earlyCards[0].date}</span>}
            <span class="early__arrow" aria-hidden="true">↗</span>
          </a>
          <p class="early__note">Comptes Instagram gérés lors de mon passage en agence.</p>
          <ul class="early__list">
            {earlyCards.map((c) => (
              <li>
                <a href={c.href} target="_blank" rel="noopener" class="early__row rippling">
                  <span class="early__name">{c.client}</span>
                  <span class="early__count">
                    {c.vues} {c.unite}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>
