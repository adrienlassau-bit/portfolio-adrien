---
/** Boîte plein écran unique, remplie par app.ts au clic d'une vignette. */
---

<dialog class="lightbox" data-lightbox-dialog aria-label="Média en plein écran">
  <div class="lightbox__inner">
    <button type="button" class="lightbox__close" data-lightbox-close aria-label="Fermer">
      &times;
    </button>
    <div class="lightbox__media" data-lightbox-media></div>
    <p class="lightbox__cap" data-lightbox-cap></p>
  </div>
</dialog>
